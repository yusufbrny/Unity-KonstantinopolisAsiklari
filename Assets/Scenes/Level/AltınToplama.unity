  m_Name: 
  m_EditorClassIdentifier: 
  nextSceneButton: {fileID: 314751316}
  ContinueButton: {fileID: 540609896}
  textDisplay: {fileID: 1573101185}
  sentences:
  - ' Patron : Demek buaraya kadar gelebildin.'
  - " Sand\u0131\u011F\u0131m kadar aptal de\u011Filmi\u015Fsin."
  - " Benimle d\xFCello yapmaya hak kazand\u0131n fakat bu d\xFCello bir k\u0131l\u0131\xE7
    sava\u015F\u0131 de\u011Fil."
  - " En \xE7ok alt\u0131n\u0131 toplama yar\u0131\u015Fmas\u0131."
  - " Seni kaleden bir odaya g\xF6t\xFCrece\u011Fim ve yukar\u0131dan sana alt\u0131nlar
    ve dikenler at\u0131lacak."
  - " Senin amac\u0131n da benden fazla alt\u0131n toplamak olacak."
  - "Ve e\u011Fer benden fazla alt\u0131n toplayabilirsen,  a\u015Fk\u0131na kavu\u015Facaks\u0131n."
  - ' Richard : Rosa...    '
  - " Onun i\xE7in her \u015Feyi yapmaya haz\u0131r\u0131m.ha"
  - " Ba\u015Fla o halde."
  typingSpeed: 0.06
