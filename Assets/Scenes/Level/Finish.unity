  m_Name: 
  m_EditorClassIdentifier: 
  nextSceneButton: {fileID: 1556215006}
  ContinueButton: {fileID: 1253986646}
  textDisplay: {fileID: 626311627}
  sentences:
  - " Ba\u015Farm\u0131\u015Fs\u0131n..."
  - ' Tebrikler!!'
  - " \u015Eimdi sana \u015Fu ana kadar ya\u015Fad\u0131\u011F\u0131n b\xFCt\xFCn
    travmalar\u0131n d\u0131\u015F\u0131nda bir travma daha ya\u015Fataca\u011F\u0131m
    san\u0131r\u0131m."
  - ' Hahahahahaha'
  - " Rosa elimde ve onu \xF6ld\xFCrmek de benim elimde..."
  - " \xDCzg\xFCn\xFCm ama iki se\xE7ene\u011Fin var \xE7aylak."
  - " Ya kendini feda edip Rosa'y\u0131 kurtar\u0131rs\u0131n ya da Rosay\u0131 feda
    edip kendini kurtar\u0131rs\u0131n."
  - " Ama sana k\xF6t\xFC bir haberim daha var.."
  - " Ya da neyse, o da sonras\u0131na kals\u0131n."
  - " Hadi bakal\u0131m, yap se\xE7imini."
  typingSpeed: 0.06
