  ContinueButton: {fileID: 635301500}
  textDisplay: {fileID: 789443279}
  sentences:
  - " Adam : Bir \u015Fey mi ar\u0131yorsunuz bay\u0131m?"
  - " Richard : Say\u0131l\u0131r, biraz sonra Atinaya kalkacak olan gemiyi ar\u0131yorum."
  - " Adam : O gemi buradan kalkm\u0131yor bay\u0131m, gemiye binebilmek i\xE7in
    kar\u015F\u0131daki limana gitmeniz gerekiyor."
  - " Richard : Kar\u015F\u0131daki limana karadan gitmem 3 saati bulur ve o zamana
    kadar gemi kalkm\u0131\u015F olur..."
  - " Adam : Limana gitmeniz i\xE7in size yard\u0131mc\u0131 olabilirim, k\xFC\xE7\xFCk
    bir teknem var, birka\xE7 kuru\u015F kar\u015F\u0131l\u0131\u011F\u0131nda sizi
    kar\u015F\u0131ya ge\xE7irebilirim."
  - " Richard: \xC7ok iyi olur!"
  - ' Adam: Hadi! atla o halde.'
  typingSpeed: 0.06
