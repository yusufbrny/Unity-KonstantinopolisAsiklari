MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 794837041}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9b79cc60b81622488b289a5b879f259, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  nextSceneButton: {fileID: 237305655}
  ContinueButton: {fileID: 1838740118}
  textDisplay: {fileID: 1177340097}
  sentences:
  - "Ya\u015Fl\u0131 Adam : Sonunda geldin evlat."
  - " Buraya kadar gelebilmen b\xFCy\xFCk bir \u015Fans de\u011Fil asl\u0131nda."
  - " Hi\xE7 d\xFC\u015F\xFCnmedin mi?, burada bu kadar \xF6l\xFC ve canavar varken
    bu aptal ya\u015Fl\u0131 neden hala hayatta ?"
  - " Ah! ben cevab\u0131 vereyim, \xE7\xFCnk\xFC ben aptal bir ya\u015Fl\u0131 de\u011Filim,
    \xE7aylak"
  - " \xC7\xFCnk\xFC ben patronun g\xF6zc\xFCs\xFCy\xFCm."
  - ' Ve o, seni istiyor!'
  - " E\u011Fer yeterince ak\u0131ll\u0131ysan onunla bir d\xFCello yapabilirsin,
    fakat bu hakk\u0131 kazanabilmek i\xE7in sana verece\u011Fim 2 g\xF6revi tamamlaman
    gerek"
  - ' Kabul etsen de, etmesen de!'
  - " \u0130lk g\xF6rev bir zeka oyunu, ikincisi ise bir dayan\u0131kl\u0131l\u0131k."
  - " E\u011Fer d\xFCelloyu kazanabilirsen."
  - ' ...'
  - " Seni sevgilinin yan\u0131na g\xF6t\xFCrebilirim."
  - " Sonunda ona kavu\u015Fursun."
  typingSpeed: 0.06
